# ==============================================================================
# PREFIXES USED FOR THIS PROJECT
# ==============================================================================

# Project-specific namespaces/qnames
@prefix :                <https://agriculture.ld.admin.ch/eCH-1234/2/> .
@prefix address:         <https://agriculture.ld.admin.ch/eCH-1234/2/address/> .
@prefix album:           <https://agriculture.ld.admin.ch/eCH-1234/2/album/> .
@prefix artist:          <https://agriculture.ld.admin.ch/eCH-1234/2/artist/> .
@prefix customer:        <https://agriculture.ld.admin.ch/eCH-1234/2/customer/> .
@prefix employee:        <https://agriculture.ld.admin.ch/eCH-1234/2/employee/> .
@prefix genre:           <https://agriculture.ld.admin.ch/eCH-1234/2/genre/> .
@prefix invline:         <https://agriculture.ld.admin.ch/eCH-1234/2/invoiceline/> .
@prefix invoice:         <https://agriculture.ld.admin.ch/eCH-1234/2/invoice/> .
@prefix media:           <https://agriculture.ld.admin.ch/eCH-1234/2/mediatype/> .
@prefix playlist:        <https://agriculture.ld.admin.ch/eCH-1234/2/playlist/> .
@prefix track:           <https://agriculture.ld.admin.ch/eCH-1234/2/tracks/> .
@prefix person:          <https://agriculture.ld.admin.ch/eCH-1234/2/person/> .

# LINDAS-specific namespaces/qnames
@prefix country:         <https://ld.admin.ch/country/> .
@prefix org:             <https://register.ld.admin.ch/opendataswiss/org/> .
@prefix cube:            <https://cube.link/> .
@prefix meta:            <https://cube.link/meta/> .
@prefix status:          <https://ld.admin.ch/vocabulary/CreativeWorkStatus/> .
@prefix theme:           <https://register.ld.admin.ch/opendataswiss/category/> .

# Globally used namespaces/qnames
@prefix adms:            <https://www.w3.org/ns/adms#> .
@prefix dcat:            <http://www.w3.org/ns/dcat#> .
@prefix dcterms:         <http://purl.org/dc/terms/> .
@prefix doap:            <http://usefulinc.com/ns/doap#> .
@prefix frequency:       <https://publications.europa.eu/resource/authority/frequency/> .
@prefix owl:             <http://www.w3.org/2002/07/owl#> .
@prefix qudt:            <http://qudt.org/schema/qudt/> .
@prefix rdf:             <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:          <http://schema.org/> .
@prefix sh:              <http://www.w3.org/ns/shacl#> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .
@prefix unit:            <http://qudt.org/vocab/unit/> .
@prefix vcard:           <http://www.w3.org/2006/vcard/ns#> .
@prefix void:            <http://rdfs.org/ns/void#> .
@prefix wikidata:        <http://www.wikidata.org/entity/> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .

# ==============================================================================
# SHACL DATA MODEL METADATA
# ==============================================================================

: a owl:Ontology ;
    rdfs:label "Chinook-Datenmodell"@de,
        "Chinook Data Model"@en,
        "Modèle de données Chinook"@fr,
        "Modello di dati Chinook"@it ;
    rdfs:comment "Dieses SHACL-Datenmodell beschreibt und validiert den integrierten Chinook-Datensatz und benutzerdefinierte Personendaten."@de,
        "This SHACL data model describes and validates the integrated Chinook dataset and custom person data."@en,
        "Ce modèle de données SHACL décrit et valide le jeu de données Chinook intégré et les données de personnes personnalisées."@fr,
        "Questo modello di dati SHACL descrive e convalida il set di dati Chinook integrato e i dati personali personalizzati."@it ;
    sh:declare [
        sh:prefix "schema" ;
        sh:namespace "http://schema.org/"^^xsd:anyURI ;
    ],
    [
        sh:prefix "" ;
        sh:namespace "https://agriculture.ld.admin.ch/eCH-1234/2/"^^xsd:anyURI ;
    ] .

:PersonShape a sh:NodeShape ;
    rdfs:label "Person"@de,
        "Person"@en,
        "Personne"@fr,
        "Persona"@it ;
    rdfs:comment """Jede Person (Mitarbeiter, Kunde oder benutzerdefinierte Person) im Datensatz.

Personen werden unabhängig von ihrer Rolle einheitlich beschrieben: Angestellte des Musikhandels, Kundinnen und Kunden sowie manuell erfasste Personen teilen dieselben Eigenschaften. Die Rolle ergibt sich aus den Beziehungen, etwa `schema:worksFor` für Angestellte oder `schema:customer` auf einer Rechnung für Kundschaft.

Namen werden so erfasst, wie sie die Person selbst verwendet; akademische Titel gehören nicht in den Vornamen. E-Mail-Adressen und Geburtsdaten sind freiwillige Angaben und werden bei Verstössen gegen die Regeln lediglich als Warnung gemeldet."""@de,
        """Any person (employee, customer, or custom person) present in the dataset.

Persons are described uniformly regardless of their role: employees of the music store, customers and manually recorded persons share the same properties. The role follows from the relationships, for example `schema:worksFor` for employees or `schema:customer` on an invoice for customers.

Names are recorded as the person uses them; academic titles do not belong in the given name. Email addresses and birth dates are optional and rule violations are reported as warnings only."""@en,
        """Toute personne (employé, client ou personne personnalisée) présente dans le jeu de données.

Les personnes sont décrites de manière uniforme, quel que soit leur rôle: le personnel du magasin de musique, la clientèle et les personnes saisies manuellement partagent les mêmes propriétés. Le rôle découle des relations, par exemple `schema:worksFor` pour le personnel ou `schema:customer` sur une facture pour la clientèle.

Les noms sont saisis tels que la personne les utilise; les titres académiques ne font pas partie du prénom. Les adresses e-mail et les dates de naissance sont facultatives et les infractions aux règles ne sont signalées que comme avertissements."""@fr,
        """Qualsiasi persona (dipendente, cliente o persona personalizzata) presente nel set di dati.

Le persone sono descritte in modo uniforme indipendentemente dal loro ruolo: il personale del negozio di musica, la clientela e le persone registrate manualmente condividono le stesse proprietà. Il ruolo deriva dalle relazioni, ad esempio `schema:worksFor` per il personale o `schema:customer` su una fattura per la clientela.

I nomi sono registrati come li usa la persona stessa; i titoli accademici non fanno parte del nome. Gli indirizzi e-mail e le date di nascita sono facoltativi e le violazioni delle regole sono segnalate solo come avvertimenti."""@it ;
    sh:targetClass schema:Person ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:order 1 ;
        sh:name "Vorname"@de,
            "Given Name"@en,
            "Prénom"@fr,
            "Nome"@it ;
        sh:path schema:givenName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Jede Person muss einen Vornamen haben."@de,
            "Every person must have a given name."@en,
            "Chaque personne doit avoir un prénom."@fr,
            "Ogni persona deve avere un nome."@it ;
    ],
    [
        sh:order 2 ;
        sh:name "Nachname"@de,
            "Family Name"@en,
            "Nom de famille"@fr,
            "Cognome"@it ;
        sh:path schema:familyName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Jede Person muss einen Nachnamen haben."@de,
            "Every person must have a family name."@en,
            "Chaque personne doit avoir un nom de famille."@fr,
            "Ogni persona deve avere un cognome."@it ;
    ],
    [
        sh:order 3 ;
        sh:name "E-Mail-Adresse"@de,
            "Email Address"@en,
            "Adresse e-mail"@fr,
            "Indirizzo email"@it ;
        sh:path schema:email ;
        sh:datatype xsd:string ;
        sh:pattern "^.+@.+\\..+$" ;
        sh:flags "i" ;
        sh:maxLength 254 ;
        sh:severity sh:Warning ;
        sh:message "Falls angegeben, muss die E-Mail-Adresse einem Standardformat entsprechen."@de,
            "If an email is provided, it must follow a standard email format."@en,
            "Si une adresse e-mail est fournie, elle doit respecter un format standard."@fr,
            "Se viene fornita un'email, deve seguire un formato standard."@it ;
    ],
    [
        sh:order 4 ;
        sh:name "Geburtsdatum"@de,
            "Birth date"@en,
            "Date de naissance"@fr,
            "Data di nascita"@it ;
        sh:path schema:birthDate ;
        sh:datatype xsd:date ;
        sh:minInclusive "1900-01-01"^^xsd:date ;
        sh:maxInclusive "2025-12-31"^^xsd:date ;
        sh:severity sh:Warning ;
        sh:message "Eine Person sollte ein gültiges Geburtsdatum haben."@de,
            "A person should have a valid birth date."@en,
            "Une personne doit avoir une date de naissance valide."@fr,
            "Una persona dovrebbe avere una data di nascita valida."@it ;
    ],
    [
        sh:order 5 ;
        sh:name "Adresse"@de,
            "Address"@en,
            "Adresse"@fr,
            "Indirizzo"@it ;
        sh:path schema:address ;
        sh:class schema:PostalAddress ;
        sh:node :PostalAddressShape ;
    ],
    [
        sh:order 6 ;
        sh:name "Arbeitet für"@de,
            "Works for"@en,
            "Travaille pour"@fr,
            "Lavora per"@it ;
        sh:path schema:worksFor ;
        sh:or (
            [ sh:class schema:Person ]
            [ sh:class schema:Organization ]
        ) ;
        sh:message "Ein Mitarbeiter kann einer anderen Person unterstellt sein."@de,
            "An employee can report to another person."@en,
            "Un employé peut relever d'une autre personne."@fr,
            "Un dipendente può fare riferimento a un'altra persona."@it ;
    ],
    [
        sh:name "Berufsbezeichnung"@de,
            "Job title"@en,
            "Titre du poste"@fr,
            "Titolo di lavoro"@it ;
        sh:order 7 ;
        sh:path schema:jobTitle ;
        sh:datatype xsd:string ;
        sh:minLength 2 ;
        sh:maxLength 100 ;
        sh:maxCount 1 ;
    ],
    [
        sh:name "Kennt"@de,
            "knows"@en,
            "Connaît"@fr,
            "Conosce"@it ;
        sh:order 8 ;
        sh:path schema:knows ;
        sh:class schema:Person ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:name "Keine Selbstunterstellung"@de,
            "No self-reporting"@en,
            "Pas d'auto-subordination"@fr,
            "Nessuna auto-subordinazione"@it ;
        dcterms:description "Ein Mitarbeiter kann nicht sich selbst unterstellt sein."@de,
            "An employee cannot report to themselves."@en,
            "Un employé ne peut pas relever de lui-même."@fr,
            "Un dipendente non può fare riferimento a se stesso."@it ;
        sh:prefixes : ;
        sh:select """
            SELECT $this
            WHERE {
                $this schema:worksFor $this .
            }
        """
    ] .

:TrackShape a sh:NodeShape ;
    rdfs:label "Musikaufnahme"@de,
        "Music Recording"@en,
        "Enregistrement musical"@fr,
        "Registrazione musicale"@it ;
    rdfs:comment "Ein einzelner Musiktitel im Chinook-Datensatz."@de,
        "A single music track in the Chinook dataset."@en,
        "Une piste musicale unique dans le jeu de données Chinook."@fr,
        "Un singolo brano musicale nel set di dati Chinook."@it ;
    sh:targetClass schema:MusicRecording ;
    sh:property [
        sh:order 1 ;
        sh:name "Name"@de,
            "Name"@en,
            "Nom"@fr,
            "Nome"@it ;
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
        sh:maxLength 200 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Jeder Titel muss einen Namen haben."@de,
            "Every track must have a name."@en,
            "Chaque piste doit avoir un nom."@fr,
            "Ogni brano deve avere un nome."@it ;
    ],
    [
        sh:order 2 ;
        sh:name "In Album"@de,
            "In Album"@en,
            "Dans l'album"@fr,
            "Nell'album"@it ;
        sh:path schema:inAlbum ;
        sh:class schema:MusicAlbum ;
        sh:message "Ein Titel kann nur zu einem gültigen schema:MusicAlbum gehören."@de,
            "A track can only belong to a valid schema:MusicAlbum."@en,
            "Une piste ne peut appartenir qu'à un schema:MusicAlbum valide."@fr,
            "Un brano può appartenere solo a un schema:MusicAlbum valido."@it ;
    ],
    [
        sh:order 3 ;
        sh:name "Autor"@de,
            "Author"@en,
            "Auteur"@fr,
            "Autore"@it ;
        sh:description "Die Person oder Gruppe, die den Titel geschrieben hat."@de,
            "The person or group who wrote the track."@en,
            "La personne ou le groupe qui a écrit la piste."@fr,
            "La persona o il gruppo che ha scritto il brano."@it ;
        sh:path schema:author ;
    ],
    [
        sh:order 4 ;
        sh:name "Genre"@de,
            "Genre"@en,
            "Genre"@fr,
            "Genere"@it ;
        sh:path schema:genre ;
        sh:class :Genre ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 5 ;
        sh:name "Dauer"@de,
            "Duration"@en,
            "Durée"@fr,
            "Durata"@it ;
        sh:path schema:duration ;
        sh:class schema:QuantitativeValue ;
        sh:message "Die Dauer muss als schema:QuantitativeValue ausgedrückt werden."@de,
            "Track duration must be expressed as a schema:QuantitativeValue."@en,
            "La durée doit être exprimée en tant que schema:QuantitativeValue."@fr,
            "La durata deve essere espressa come schema:QuantitativeValue."@it ;
    ],
    [
        sh:order 6 ;
        sh:name "Dateigrösse"@de,
            "Content Size"@en,
            "Taille du contenu"@fr,
            "Dimensione del contenuto"@it ;
        sh:path schema:contentSize ;
        sh:class schema:QuantitativeValue ;
    ] .

:MusicAlbumShape a sh:NodeShape ;
    rdfs:label "Musikalbum"@de,
        "Music album"@en,
        "Album de musique"@fr,
        "Album musicale"@it ;
    rdfs:comment "Eine Sammlung von Titeln im Chinook-Datensatz."@de,
        "A collection of tracks in the Chinook dataset."@en,
        "Une collection de pistes dans le jeu de données Chinook."@fr,
        "Una raccolta di brani nel set di dati Chinook."@it ;
    sh:targetClass schema:MusicAlbum ;
    sh:property [
        sh:order 1 ;
        sh:name "Name"@de,
            "Name"@en,
            "Nom"@fr,
            "Nome"@it ;
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:maxLength 200 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Jedes Album muss einen Namen haben."@de,
            "Every album must have a name."@en,
            "Chaque album doit avoir un nom."@fr,
            "Ogni album deve avere un nome."@it ;
    ],
    [
        sh:order 2 ;
        sh:name "Künstler"@de,
            "Artist"@en,
            "Artiste"@fr,
            "Artista"@it ;
        sh:description "Person oder Musikgruppe, die das Album erstellt hat."@de,
            "Person or music group who created the album."@en,
            "Personne ou groupe de musique ayant créé l'album."@fr,
            "Persona o gruppo musicale che ha creato l'album."@it ;
        sh:path schema:byArtist ;
        sh:or (
            [ sh:class schema:Person ]
            [ sh:class schema:MusicGroup ]
        ) ;
    ] .

:OrganisationShape a sh:NodeShape ;
    rdfs:label "Organisation"@de,
        "Organisation"@en,
        "Organisation"@fr,
        "Organizzazione"@it ;
    rdfs:comment "Ein Unternehmen oder eine Organisation im Chinook-Datensatz."@de,
        "A company or organization in the Chinook dataset."@en,
        "Une entreprise ou organisation dans le jeu de données Chinook."@fr,
        "Un'azienda o organizzazione nel set di dati Chinook."@it ;
    sh:targetClass schema:Organisation ;
    sh:property [
        sh:order 1 ;
        sh:name "Name"@de,
            "Name"@en,
            "Nom"@fr,
            "Nome"@it ;
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minLength 2 ;
        sh:maxLength 100 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Jede Organisation muss einen Namen haben."@de,
            "Every organisation must have a name."@en,
            "Chaque organisation doit avoir un nom."@fr,
            "Ogni organizzazione deve avere un nome."@it ;
    ] .

:InvoiceShape a sh:NodeShape ;
    rdfs:label "Rechnung"@de,
        "Invoice"@en,
        "Facture"@fr,
        "Fattura"@it ;
    rdfs:comment """Ein Kaufbeleg im Chinook-Datensatz. Eine Rechnung fasst die Positionen eines Kaufs zusammen. Der Rechnungsbetrag wird nicht nur als Wert erfasst, sondern auch gegen die Summe der Positionen geprüft; Abweichungen von mehr als fünf Rappen gelten als Fehler. Rechnungen vor dem Jahr 2000 stammen aus einem Altsystem und sind in diesem Datensatz nicht zulässig."""@de,
        """A purchase receipt in the Chinook dataset. An invoice groups the items of one purchase. The invoice total is not only recorded as a value but also checked against the sum of its items; differences of more than five cents count as errors. Invoices dated before the year 2000 stem from a legacy system and are not permitted in this dataset."""@en,
        """Un reçu d'achat dans le jeu de données Chinook. Une facture regroupe les positions d'un achat. Le montant de la facture n'est pas seulement saisi comme valeur, il est aussi vérifié par rapport à la somme des positions; des écarts de plus de cinq centimes sont considérés comme des erreurs. Les factures antérieures à l'an 2000 proviennent d'un ancien système et ne sont pas admises dans ce jeu de données."""@fr,
        """Una ricevuta di acquisto nel set di dati Chinook. Una fattura raggruppa le posizioni di un acquisto. L'importo della fattura non viene solo registrato come valore, ma anche verificato rispetto alla somma delle posizioni; differenze superiori a cinque centesimi sono considerate errori. Le fatture antecedenti all'anno 2000 provengono da un sistema precedente e non sono ammesse in questo set di dati."""@it ;
    sh:targetClass schema:Invoice ;
    sh:property [
        sh:order 1 ;
        sh:name "Kunde"@de,
            "Customer"@en,
            "Client"@fr,
            "Cliente"@it ;
        sh:path schema:customer ;
        sh:class schema:Person ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Eine Rechnung muss genau einem Kunden zugeordnet sein."@de,
            "An invoice must be linked to exactly one customer."@en,
            "Une facture doit être liée à exactement un client."@fr,
            "Una fattura deve essere collegata a esattamente un cliente."@it ;
    ],
    [
        sh:order 2 ;
        sh:name "Fälliger Gesamtbetrag"@de,
            "Total payment due"@en,
            "Paiement total dû"@fr,
            "Pagamento totale dovuto"@it ;
        sh:path schema:totalPaymentDue ;
        sh:class schema:QuantitativeValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Eine Rechnung muss einen fälligen Gesamtbetrag als schema:QuantitativeValue definieren."@de,
            "An invoice must define a total payment due as a schema:QuantitativeValue."@en,
            "Une facture doit définir un paiement total dû en tant que schema:QuantitativeValue."@fr,
            "Una fattura deve definire un pagamento totale dovuto come schema:QuantitativeValue."@it ;
    ],
    [
        sh:order 3 ;
        sh:name "Enthält"@de,
            "Has part"@en,
            "Contient"@fr,
            "Contiene"@it ;
        sh:path schema:hasPart ;
        sh:class schema:OrderItem ;
        sh:minCount 1 ;
        sh:message "Eine Rechnung muss mindestens eine Position (OrderItem) enthalten."@de,
            "An invoice must have at least one line item (OrderItem)."@en,
            "Une facture doit avoir au moins un article (OrderItem)."@fr,
            "Una fattura deve avere almeno una riga di ordine (OrderItem)."@it ;
    ],
    [
        sh:order 4 ;
        sh:name "Erstellungsdatum"@de,
            "Date created"@en,
            "Date de création"@fr,
            "Data di creazione"@it ;
        sh:path schema:dateCreated ;
        sh:datatype xsd:date ;
        sh:minInclusive "2000-01-01"^^xsd:date ;
        skos:example "2024-05-21"^^xsd:date,
            "2001-01-01"^^xsd:date ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:name "Rechnungssumme"@de,
            "Invoice total"@en,
            "Total de la facture"@fr,
            "Totale della fattura"@it ;
        dcterms:description "Die Rechnungssumme muss exakt mit der Summe ihrer Positionen übereinstimmen (Toleranz 0.05)."@de,
            "Invoice total payment due must exactly match the sum of its lines (within 0.05 tolerance)."@en,
            "Le total de la facture doit correspondre exactement à la somme de ses lignes (tolérance de 0.05)."@fr,
            "Il totale della fattura deve corrispondere esattamente alla somma delle sue righe (tolleranza di 0.05)."@it ;
        sh:prefixes : ;
        sh:select """
            SELECT $this
            WHERE {
                $this schema:totalPaymentDue/schema:value ?invoiceTotal .
                {
                    SELECT $this (SUM(?price * ?qty) AS ?calculatedTotal)
                    WHERE {
                        $this schema:hasPart ?line .
                        ?line schema:price/schema:value ?price .
                        ?line schema:orderQuantity/schema:value ?qty .
                    }
                    GROUP BY $this
                }
                FILTER(ABS(?invoiceTotal - ?calculatedTotal) > 0.05)
            }
        """
    ],
    [
        a sh:SPARQLConstraint ;
        sh:name "Rechnungsdatum"@de,
            "Invoice date"@en,
            "Date de la facture"@fr,
            "Data della fattura"@it ;
        dcterms:description "Eine Rechnung darf nicht vor dem Jahr 2000 datiert sein."@de,
            "An invoice cannot be dated before the year 2000."@en,
            "Une facture ne peut pas être datée d'avant l'année 2000."@fr,
            "Una fattura non può essere datata prima dell'anno 2000."@it ;
        sh:prefixes : ;
        sh:select """
            SELECT $this
            WHERE {
                $this schema:dateCreated ?date .
                FILTER(?date < "2000-01-01"^^xsd:date)
            }
        """
    ] .

:QuantitativeValueShape a sh:NodeShape ;
    rdfs:label "Quantitativer Wert"@de,
        "Quantitative Value"@en,
        "Valeur quantitative"@fr,
        "Valore quantitativo"@it ;
    rdfs:comment """Ein numerischer Wert mit einer dazugehörigen Einheit.

Quantitative Werte werden nie als blosse Zahl erfasst, sondern immer zusammen mit einer Einheit aus dem QUDT-Vokabular. So bleibt eindeutig, ob eine Dauer in Millisekunden oder eine Dateigrösse in Bytes gemeint ist. Negative Werte sind in diesem Datensatz nicht vorgesehen."""@de,
        """A numerical value with an associated unit.

Quantitative values are never recorded as a bare number but always together with a unit from the QUDT vocabulary. This keeps it unambiguous whether a duration is meant in milliseconds or a file size in bytes. Negative values are not foreseen in this dataset."""@en,
        """Une valeur numérique avec une unité associée.

Les valeurs quantitatives ne sont jamais saisies comme un simple nombre, mais toujours avec une unité du vocabulaire QUDT. Il reste ainsi clair si une durée est exprimée en millisecondes ou une taille de fichier en octets. Les valeurs négatives ne sont pas prévues dans ce jeu de données."""@fr,
        """Un valore numerico con un'unità associata.

I valori quantitativi non vengono mai registrati come semplice numero, ma sempre insieme a un'unità del vocabolario QUDT. Resta così chiaro se una durata è espressa in millisecondi o una dimensione di file in byte. I valori negativi non sono previsti in questo set di dati."""@it ;
    sh:targetClass schema:QuantitativeValue ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:order 1 ;
        sh:name "Wert"@de,
            "Value"@en,
            "Valeur"@fr,
            "Valore"@it ;
        sh:path schema:value ;
        sh:or (
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:integer ]
        ) ;
        sh:minInclusive 0 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ein quantitativer Wert muss genau einen numerischen Wert haben."@de,
            "A quantitative value must have exactly one numeric value."@en,
            "Une valeur quantitative doit avoir exactement une valeur numérique."@fr,
            "Un valore quantitativo deve avere esattamente un valore numerico."@it ;
    ],
    [
        sh:order 2 ;
        sh:name "Einheitencode"@de,
            "Unit Code"@en,
            "Code d'unité"@fr,
            "Codice unità"@it ;
        sh:path schema:unitCode ;
        sh:nodeKind sh:IRI ;
        sh:in ( unit:USD unit:EA unit:BYTE unit:MilliSEC ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Ein quantitativer Wert muss seine Einheit über eine unitCode-URI angeben."@de,
            "A quantitative value must specify its unit via a unitCode URI."@en,
            "Une valeur quantitative doit spécifier son unité via une URI unitCode."@fr,
            "Un valore quantitativo deve specificare la sua unità tramite un'URI unitCode."@it ;
    ] .

:GenreShape a sh:NodeShape ;
    rdfs:label "Genre"@de,
        "Genre"@en,
        "Genre"@fr,
        "Genere"@it ;
    rdfs:comment "Eine musikalische Kategorie im Chinook-Datensatz."@de,
        "A musical category in the Chinook dataset."@en,
        "Une catégorie musicale dans le jeu de données Chinook."@fr,
        "Una categoria musicale nel set di dati Chinook."@it ;
    sh:targetClass :Genre ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:order 1 ;
        sh:name "Name"@de,
            "Name"@en,
            "Nom"@fr,
            "Nome"@it ;
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minLength 2 ;
        sh:maxLength 50 ;
        sh:pattern "^[A-Z]" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ],
    [
        sh:order 2 ;
        sh:name "Teil von"@de,
            "Part of"@en,
            "Partie de"@fr,
            "Parte di"@it ;
        sh:path schema:partOf ;
        sh:nodeKind sh:IRI ;
        sh:class :Genre ;
    ],
    [
        sh:order 3 ;
        sh:name "Alternative Bezeichnung"@de,
            "Alternate name"@en,
            "Dénomination alternative"@fr,
            "Denominazione alternativa"@it ;
        sh:description "Übersetzte oder umgangssprachliche Bezeichnung des Genres, höchstens eine pro Sprache."@de,
            "Translated or colloquial name of the genre, at most one per language."@en,
            "Dénomination traduite ou familière du genre, au plus une par langue."@fr,
            "Denominazione tradotta o colloquiale del genere, al massimo una per lingua."@it ;
        sh:path schema:alternateName ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "de" "fr" "it" "en" ) ;
        sh:uniqueLang true ;
        sh:maxLength 50 ;
        sh:message "Alternative Bezeichnungen müssen eine der Landessprachen oder Englisch als Sprache tragen, je Sprache höchstens eine."@de,
            "Alternate names must carry a national language or English as language tag, at most one per language."@en,
            "Les dénominations alternatives doivent porter une langue nationale ou l'anglais, au plus une par langue."@fr,
            "Le denominazioni alternative devono avere una lingua nazionale o l'inglese come lingua, al massimo una per lingua."@it ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:name "Keine zyklische Hierarchie"@de,
            "No cyclic hierarchy"@en,
            "Pas de hiérarchie cyclique"@fr,
            "Nessuna gerarchia ciclica"@it ;
        dcterms:description "Ein Genre darf weder direkt noch transitiv ein Teil von sich selbst sein."@de,
            "A genre cannot be a part of itself, either directly or transitively."@en,
            "Un genre ne peut pas faire partie de lui-même, ni directement ni transitivement."@fr,
            "Un genere non può essere parte di se stesso, né direttamente né transitivamente."@it ;
        sh:prefixes : ;
        sh:select """
            SELECT $this
            WHERE {
                $this schema:partOf+ $this .
            }
        """
    ] .

:PostalAddressShape a sh:NodeShape ;
    rdfs:label "Postadresse"@de,
        "Postal address"@en,
        "Adresse postale"@fr,
        "Indirizzo postale"@it ;
    rdfs:comment """Die Postadresse einer Person.

Adressen folgen dem Aufbau von schema.org und nicht dem Schweizer Adressstandard eCH-0010, da der Datensatz überwiegend ausländische Adressen enthält. Postleitzahlen werden deshalb nur auf ein plausibles Format geprüft, nicht gegen ein Verzeichnis."""@de,
        """The postal address of a person.

Addresses follow the structure of schema.org rather than the Swiss address standard eCH-0010, since the dataset contains mostly foreign addresses. Postal codes are therefore only checked for a plausible format, not against a directory."""@en,
        """L'adresse postale d'une personne.

Les adresses suivent la structure de schema.org et non la norme suisse d'adresse eCH-0010, car le jeu de données contient surtout des adresses étrangères. Les codes postaux ne sont donc vérifiés que quant à leur format plausible, et non par rapport à un répertoire."""@fr,
        """L'indirizzo postale di una persona.

Gli indirizzi seguono la struttura di schema.org e non lo standard svizzero eCH-0010, poiché il set di dati contiene soprattutto indirizzi esteri. I codici postali vengono quindi verificati solo per un formato plausibile, non rispetto a un elenco."""@it ;
    sh:targetClass schema:PostalAddress ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:order 1 ;
        sh:name "Strasse und Hausnummer"@de,
            "Street address"@en,
            "Rue et numéro"@fr,
            "Via e numero civico"@it ;
        sh:path schema:streetAddress ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 3 ;
        sh:maxLength 100 ;
        skos:example "Schwarzenburgstrasse 165" ;
    ],
    [
        sh:order 2 ;
        sh:name "Postleitzahl"@de,
            "Postal code"@en,
            "Code postal"@fr,
            "Codice postale"@it ;
        sh:description "Buchstaben, Ziffern, Leerzeichen und Bindestriche, zwei bis zehn Zeichen."@de,
            "Letters, digits, spaces and hyphens, two to ten characters."@en,
            "Lettres, chiffres, espaces et traits d'union, de deux à dix caractères."@fr,
            "Lettere, cifre, spazi e trattini, da due a dieci caratteri."@it ;
        sh:path schema:postalCode ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:pattern "^[A-Za-z0-9][A-Za-z0-9 -]{1,9}$" ;
        sh:severity sh:Warning ;
        sh:message "Die Postleitzahl hat kein plausibles Format."@de,
            "The postal code does not have a plausible format."@en,
            "Le code postal n'a pas un format plausible."@fr,
            "Il codice postale non ha un formato plausibile."@it ;
    ],
    [
        sh:order 3 ;
        sh:name "Ort"@de,
            "Locality"@en,
            "Localité"@fr,
            "Località"@it ;
        sh:path schema:addressLocality ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:maxLength 100 ;
        sh:message "Jede Adresse braucht genau einen Ort."@de,
            "Every address needs exactly one locality."@en,
            "Chaque adresse requiert exactement une localité."@fr,
            "Ogni indirizzo richiede esattamente una località."@it ;
    ],
    [
        sh:order 4 ;
        sh:name "Region"@de,
            "Region"@en,
            "Région"@fr,
            "Regione"@it ;
        sh:description "Kanton, Bundesstaat oder Provinz, sofern im Land üblich."@de,
            "Canton, state or province where customary in the country."@en,
            "Canton, État ou province, lorsque c'est l'usage dans le pays."@fr,
            "Cantone, stato o provincia, se consuetudinario nel paese."@it ;
        sh:path schema:addressRegion ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:maxLength 100 ;
    ],
    [
        sh:order 5 ;
        sh:name "Land"@de,
            "Country"@en,
            "Pays"@fr,
            "Paese"@it ;
        sh:description "Land als IRI aus dem Länderverzeichnis des Bundesarchivs auf LINDAS (ISO 3166-1 alpha-3)."@de,
            "Country as an IRI from the country list of the Swiss Federal Archives on LINDAS (ISO 3166-1 alpha-3)."@en,
            "Pays sous forme d'IRI tirée de la liste des pays des Archives fédérales sur LINDAS (ISO 3166-1 alpha-3)."@fr,
            "Paese come IRI dall'elenco dei paesi dell'Archivio federale su LINDAS (ISO 3166-1 alpha-3)."@it ;
        sh:path schema:addressCountry ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^https://ld\\.admin\\.ch/country/[A-Z]{3}$" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        skos:example country:FRA, country:ITA, country:CHE ;
        sh:message "Jede Adresse braucht genau ein Land als Länder-IRI von LINDAS."@de,
            "Every address needs exactly one country as a LINDAS country IRI."@en,
            "Chaque adresse requiert exactement un pays sous forme d'IRI de pays LINDAS."@fr,
            "Ogni indirizzo richiede esattamente un paese come IRI di paese LINDAS."@it ;
    ] .
