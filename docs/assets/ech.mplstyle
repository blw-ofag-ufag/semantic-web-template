# Plot style of the documentation, used by the Python code chunks with
#   plt.style.use("../assets/ech.mplstyle")
# Mirrors ggplot2's theme_minimal(): no axis lines or ticks, a light grey grid
# behind the data, grey tick labels and the eCH red as the default colour.

# Figure (white background, also in the dark theme of the website)
figure.facecolor: white
figure.dpi: 96
savefig.facecolor: white
figure.constrained_layout.use: True   # fills the figure like ggplot2
figure.constrained_layout.h_pad: 0.076   # 5.5 pt margin
figure.constrained_layout.w_pad: 0.076
savefig.pad_inches: 0.076   # restores the margin that the tight bounding box of Jupyter cuts off

# Fonts and text (Nimbus Sans is also the font of the PDF)
font.family: sans-serif
font.sans-serif: Nimbus Sans, Helvetica, Arial, Liberation Sans, DejaVu Sans
font.size: 11
text.color: black
axes.labelcolor: black
axes.labelsize: 11
axes.titlesize: 13.2
axes.titlelocation: left
xtick.labelsize: 8.8
ytick.labelsize: 8.8
xtick.color: 4D4D4D
ytick.color: 4D4D4D
xtick.labelcolor: 4D4D4D
ytick.labelcolor: 4D4D4D

# Colours: eCH red first
axes.prop_cycle: cycler('color', ['D00D28', '4D4D4D', '1F77B4', 'FF7F0E', '2CA02C'])
patch.edgecolor: none

# Panel: no frame, no ticks, grid behind the data
axes.facecolor: white
axes.edgecolor: white
axes.spines.left: False
axes.spines.right: False
axes.spines.top: False
axes.spines.bottom: False
axes.grid: True
axes.grid.which: both
axes.axisbelow: True
axes.xmargin: 0.05
axes.ymargin: 0.05
grid.color: EBEBEB
grid.linewidth: 1.42
grid.linestyle: -
xtick.major.size: 0
ytick.major.size: 0
xtick.minor.size: 0
ytick.minor.size: 0
xtick.major.pad: 2.2
ytick.major.pad: 2.2
xtick.minor.ndivs: 2
ytick.minor.ndivs: 2

# Legend without frame
legend.frameon: False
legend.fontsize: 8.8
